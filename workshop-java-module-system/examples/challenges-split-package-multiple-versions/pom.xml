<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>demo</groupId>
    <artifactId>challenges-split-package-multiple-versions</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Challenges - Split Package - Multiple Version</name>
    <description>
        This project is a collection of simple code examples related to the
        split package example.
    </description>

    <properties>
        <java.version>25</java.version>

        <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <required.maven.version>3.6.3</required.maven.version>
    </properties>

    <modules>
        <module>app</module>
        <module>db</module>
        <module>domain-v1</module>
        <module>domain-v2</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>run-ant-task</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/libs"/>
                                <copy todir="${project.build.directory}/libs">
                                    <fileset dir="${basedir}/app/target/libs" includes="app.jar"/>
                                    <fileset dir="${basedir}/db/target/libs" includes="db.jar"/>
                                    <fileset dir="${basedir}/domain-v1/target/libs" includes="domain-v1.jar"/>
                                    <fileset dir="${basedir}/domain-v2/target/libs" includes="domain-v2.jar"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${required.maven.version}</version>
                                    <message>Maven ${required.maven.version}+ is required. Use the Maven Wrapper or upgrade your Maven installation.</message>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                    <message>Java ${java.version}+ is required.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
